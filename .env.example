# Copy this file to .env and fill in your values.
# .env is git-ignored and must never be committed.

# ------------------------------------------------------------
# Required: Anthropic API key for LLM-assisted suggestions.
# Obtain one at https://console.anthropic.com/
# ------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# ------------------------------------------------------------
# Optional: fragment library settings (optimizer).
#
# FRAGNET_LIBRARY_PKL — path to the pre-built fragment library
#   pickle. Can be absolute or relative to the project root.
#   Defaults to chembl_library.pkl in the project root if unset.
#
# FRAGNET_LIBRARY_SOURCE — which library the optimizer uses:
#   auto      use the pickle if found, fall back to built-in 47-fragment set
#   chembl    force the pickle; raises an error if it cannot be loaded
#   reference force the built-in 47-fragment set (no pickle needed)
#
# FRAGNET_CONTRIBUTION_PRIOR — whether to prioritise replacement
#   fragments by their mean/std contribution signal-to-noise score.
#   Only has an effect when the library was built with --contributions.
#   true | false
# ------------------------------------------------------------
FRAGNET_LIBRARY_PKL=chembl_library.pkl
FRAGNET_LIBRARY_SOURCE=auto
FRAGNET_CONTRIBUTION_PRIOR=false
